const GALLERY_ITEMS = galleryList.map((item) => {
  const matchKey = Object.keys(rawImages).find((k) => k.includes(item.fileName));
  const src = matchKey ? rawImages[matchKey].default : "";
  return {
    ...item,
    altEn: item.titleEn,
    altId: item.titleId,
    thumbSrc: src,
    fullSrc: src,
  };
});
---

<!-- ====== GALLERY ====== -->
<section id="galeri">
  <div class="bg-word" style="bottom:-4%;left:-3%" aria-hidden="true">STAGE</div>
  <div class="container">
    <div class="sec-head" data-reveal>
      <div class="eyebrow" data-i18n="gallery.eyebrow">03 — GALLERY</div>
      <h2 class="sec-title split" data-i18n="gallery.title">Proof that we actually practice.</h2>
      <p class="sec-sub" data-i18n="gallery.sub">Trace of our studio sessions and stage performances — click any photo to enlarge.</p>
    </div>

    <div class="masonry" id="masonry">
      {GALLERY_ITEMS.map((item) => (
        <figure
          class="g-item"
          tabindex="0"
          role="button"
          aria-label={`Enlarge photo: ${item.titleEn}`}
          data-cap-en={item.captionEn}
          data-cap-id={item.captionId}
          data-cap={item.captionEn}
          data-full={item.fullSrc}
        >
          <img
            src={item.thumbSrc}
            alt={item.altEn}
            data-alt-en={item.altEn}
            data-alt-id={item.altId}
            loading="lazy"
          />
          <figcaption class="g-cap">
            <span data-en={item.titleEn} data-id={item.titleId}>{item.titleEn}</span>
            <i data-lucide="maximize-2"></i>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
