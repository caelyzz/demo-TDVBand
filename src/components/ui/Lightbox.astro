---
---

<div class="lb" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo gallery modal">
  <button class="lb-btn" id="lbClose" aria-label="Close">
    <i data-lucide="x"></i>
  </button>
  <button class="lb-btn" id="lbPrev" aria-label="Previous photo">
    <i data-lucide="chevron-left"></i>
  </button>
  <figure>
    <img id="lbImg" src="" alt="">
    <div class="lb-bar">
      <span id="lbCap"></span>
      <span class="lb-count" id="lbCount"></span>
    </div>
  </figure>
  <button class="lb-btn" id="lbNext" aria-label="Next photo">
    <i data-lucide="chevron-right"></i>
  </button>
</div>
